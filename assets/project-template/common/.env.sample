# Copy to .env (gitignored) and fill in the provider you use. Never commit .env.
# {{buildTool}} decides which provider starter to add by looking for these variables, so they
# must be exported in the shell that runs {{buildTool}}:
#   set -a; source .env; set +a
# The application also reads this file at startup (spring.config.import), so keep plain KEY=VALUE
# lines: no "export", no quotes.
# Local models through Ollama need no key: run with {{ollamaRunCommand}}

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint (a gateway, a proxy, a self-hosted server).
# The base URL must include /v1, for example https://api.openai.com/v1
OPENAI_CUSTOM_API_KEY=
OPENAI_CUSTOM_BASE_URL=
LLM_MODEL=gpt-4o-mini
